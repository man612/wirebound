{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Wirebound Tauri Lab",
  "version": "0.0.1",
  "identifier": "com.wirebound.taurilab",
  "build": {
    "beforeDevCommand": "npm run dev:web",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build:web",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Wirebound Tauri Lab",
        "width": 1000,
        "height": 720,
        "minWidth": 760,
        "minHeight": 560,
        "decorations": false,
        "visible": false,
        "backgroundColor": "#09090b"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'none'; object-src 'none'; base-uri 'none'; frame-src 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["../../../build/icon.ico"]
  }
}
